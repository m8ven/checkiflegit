---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StoreList from '../../../components/StoreList.astro';
import Pagination from '../../../components/Pagination.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getIndexableStores, groupBy, TIER_META, type Store } from '../../../lib/catalog';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const stores = await getIndexableStores();
  const groups = groupBy(stores, (s) => s.data.verdict.tier);
  return [...groups.entries()]
    .filter(([tier]) => tier in TIER_META)
    .flatMap(([tier, list]) => paginate(list, { params: { tier }, props: { tier }, pageSize: 150 }));
};

const { page, tier } = Astro.props as { page: Page<Store>; tier: string };
const meta = TIER_META[tier];
const suffix = page.lastPage > 1 ? ` (page ${page.currentPage} of ${page.lastPage})` : '';
---
<BaseLayout
  title={`${meta.heading}${suffix} — CheckIfLegit`}
  description={`${page.total} online stores where our automated check found ${meta.short.toLowerCase()}. ${meta.blurb}`}
>
  <p class="eyebrow"><a href="/verdict/">← All ratings</a></p>
  <h1>{meta.heading}</h1>
  <p class="muted">
    {meta.blurb} {page.total} stores in our index fall into this band.
    {page.lastPage > 1 && <> Page {page.currentPage} of {page.lastPage}.</>}
  </p>

  <AdSlot id="hub-top" />

  <StoreList stores={page.data} />

  <Pagination base={`/verdict/${tier}/`} currentPage={page.currentPage} lastPage={page.lastPage} />

  <h2>Browse another way</h2>
  <ul>
    <li><a href="/stores/">All store checks, A–Z</a></li>
    <li><a href="/platform/">By e-commerce platform</a></li>
    <li><a href="/tld/">By country / domain extension</a></li>
  </ul>
</BaseLayout>
