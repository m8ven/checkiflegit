---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StoreList from '../../../components/StoreList.astro';
import Pagination from '../../../components/Pagination.astro';
import AdSlot from '../../../components/AdSlot.astro';
import {
  getIndexableStores, groupBy, tldOf, toSegment, MIN_HUB_SIZE, type Store,
} from '../../../lib/catalog';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const stores = await getIndexableStores();
  const groups = groupBy(stores, (s) => tldOf(s.data.domain));
  return [...groups.entries()]
    .filter(([, list]) => list.length >= MIN_HUB_SIZE)
    .flatMap(([tld, list]) =>
      paginate(list, { params: { tld: toSegment(tld) }, props: { tld }, pageSize: 150 })
    );
};

const { page, tld } = Astro.props as { page: Page<Store>; tld: string };
const suffix = page.lastPage > 1 ? ` (page ${page.currentPage} of ${page.lastPage})` : '';
---
<BaseLayout
  title={`.${tld} stores we've checked${suffix} — CheckIfLegit`}
  description={`Trust-signal checks for ${page.total} online stores on .${tld} domains — domain age, SSL, contact details, policy pages and social presence.`}
>
  <p class="eyebrow"><a href="/tld/">← All domain extensions</a></p>
  <h1>.{tld} stores we've checked</h1>
  <p class="muted">
    {page.total} stores in our index use a <strong>.{tld}</strong> domain. A country-code
    extension is not a trust signal in itself, but it is useful context — for example when
    checking whether a store's stated location matches where it presents itself as trading.
    {page.lastPage > 1 && <> Page {page.currentPage} of {page.lastPage}.</>}
  </p>

  <AdSlot id="hub-top" />

  <StoreList stores={page.data} />

  <Pagination base={`/tld/${toSegment(tld)}/`} currentPage={page.currentPage} lastPage={page.lastPage} />

  <h2>Browse another way</h2>
  <ul>
    <li><a href="/stores/">All store checks, A–Z</a></li>
    <li><a href="/platform/">By e-commerce platform</a></li>
    <li><a href="/verdict/">By trust-signal rating</a></li>
  </ul>
</BaseLayout>
