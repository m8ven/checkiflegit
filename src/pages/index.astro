---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import StoreList from '../components/StoreList.astro';
import {
  getIndexableStores, groupBy, platformOf, tldOf, toSegment, MIN_HUB_SIZE, TIERS, TIER_META,
} from '../lib/catalog';

const stores = await getIndexableStores();

// The A–Z index is paginated at 150/page; linking every page from here keeps
// each store page exactly two clicks from the homepage.
const PAGE_SIZE = 150;
const lastPage = Math.ceil(stores.length / PAGE_SIZE);
const pageRanges = Array.from({ length: lastPage }, (_, i) => {
  const slice = stores.slice(i * PAGE_SIZE, (i + 1) * PAGE_SIZE);
  return {
    n: i + 1,
    href: i === 0 ? '/stores/' : `/stores/${i + 1}/`,
    from: slice[0]?.data.domain ?? '',
    to: slice[slice.length - 1]?.data.domain ?? '',
  };
});

const platforms = [...groupBy(stores, platformOf).entries()]
  .filter(([, l]) => l.length >= MIN_HUB_SIZE)
  .sort((a, b) => b[1].length - a[1].length);

const tlds = [...groupBy(stores, (s) => tldOf(s.data.domain)).entries()]
  .filter(([, l]) => l.length >= MIN_HUB_SIZE)
  .sort((a, b) => b[1].length - a[1].length);

const tierCounts = groupBy(stores, (s) => s.data.verdict.tier);

const recent = [...stores]
  .sort((a, b) => Date.parse(b.data.fetchedAt) - Date.parse(a.data.fetchedAt))
  .slice(0, 40);
---
<BaseLayout
  title="CheckIfLegit — Is that online store legit?"
  description="Automated trust-signal checks for thousands of online stores. Domain age, SSL, contact info, reviews and more — so you can shop with confidence."
>
  <h1>Is that online store legit?</h1>
  <p class="muted">
    We run an automated trust-signal check on online stores — domain age, SSL security,
    contact details, policy pages, review footprint and social presence — and summarise
    what we find in plain language. <strong>{stores.length}</strong> stores checked so far.
  </p>

  <p><a href="/search">Search for a specific store →</a></p>

  <AdSlot id="home-top" />

  <h2>Browse by trust-signal rating</h2>
  <ul class="store-list">
    {TIERS.map((tier) => (
      <li>
        <a href={`/verdict/${tier}/`}>{TIER_META[tier].heading}</a>
        <span class={`pill ${tier}`}>{tierCounts.get(tier)?.length ?? 0} stores</span>
      </li>
    ))}
  </ul>

  <h2>Browse by e-commerce platform</h2>
  <ul class="chips">
    {platforms.map(([name, list]) => (
      <li><a class="chip" href={`/platform/${toSegment(name)}/`}>{name} <span>{list.length}</span></a></li>
    ))}
  </ul>
  <p class="muted small"><a href="/platform/">All platforms →</a></p>

  <h2>Browse by country &amp; domain extension</h2>
  <ul class="chips">
    {tlds.map(([tld, list]) => (
      <li><a class="chip" href={`/tld/${toSegment(tld)}/`}>.{tld} <span>{list.length}</span></a></li>
    ))}
  </ul>
  <p class="muted small"><a href="/tld/">All domain extensions →</a></p>

  <h2>Every store we've checked, A–Z</h2>
  <p class="muted">
    The full index, {PAGE_SIZE} stores per page. Jump straight to the range you need.
  </p>
  <ol class="range-list">
    {pageRanges.map((p) => (
      <li><a href={p.href}><span class="range-list__n">{p.n}</span> {p.from} – {p.to}</a></li>
    ))}
  </ol>

  <h2>Recently checked stores</h2>
  <StoreList stores={recent} />
  <p class="muted small"><a href="/stores/">Browse all {stores.length} store checks →</a></p>
</BaseLayout>
