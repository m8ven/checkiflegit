---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StoreList from '../../../components/StoreList.astro';
import Pagination from '../../../components/Pagination.astro';
import AdSlot from '../../../components/AdSlot.astro';
import {
  getIndexableStores, groupBy, platformOf, toSegment, MIN_HUB_SIZE, type Store,
} from '../../../lib/catalog';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const stores = await getIndexableStores();
  const groups = groupBy(stores, platformOf);
  return [...groups.entries()]
    .filter(([, list]) => list.length >= MIN_HUB_SIZE)
    .flatMap(([name, list]) =>
      paginate(list, {
        params: { platform: toSegment(name) },
        props: { platformName: name },
        pageSize: 150,
      })
    );
};

const { page, platformName } = Astro.props as { page: Page<Store>; platformName: string };
const base = `/platform/${toSegment(platformName)}/`;
const suffix = page.lastPage > 1 ? ` (page ${page.currentPage} of ${page.lastPage})` : '';
---
<BaseLayout
  title={`${platformName} stores we've checked${suffix} — CheckIfLegit`}
  description={`Trust-signal checks for ${page.total} online stores built on ${platformName}. Domain age, SSL, contact details, policy pages and social presence.`}
>
  <p class="eyebrow"><a href="/platform/">← All platforms</a></p>
  <h1>{platformName} stores we've checked</h1>
  <p class="muted">
    We detected <strong>{platformName}</strong> on {page.total} of the stores in our index.
    The platform a store runs on is one signal among several — an established platform is a
    mild positive, but it says nothing on its own about the business behind the store.
    {page.lastPage > 1 && <> Page {page.currentPage} of {page.lastPage}.</>}
  </p>

  <AdSlot id="hub-top" />

  <StoreList stores={page.data} />

  <Pagination base={base} currentPage={page.currentPage} lastPage={page.lastPage} />

  <h2>Browse another way</h2>
  <ul>
    <li><a href="/stores/">All store checks, A–Z</a></li>
    <li><a href="/verdict/">By trust-signal rating</a></li>
    <li><a href="/tld/">By country / domain extension</a></li>
  </ul>
</BaseLayout>
